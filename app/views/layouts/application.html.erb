<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Post" %></title>
    <%= favicon_link_tag 'favicon.ico' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Post">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />


    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div class="header-logo">
        <%= link_to("Post","/") %>
      </div>

      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="<%= t('nav.toggle_menu') %>">
        <i class="fas fa-bars"></i>
      </button>

      <ul class="header-menus" id="headerMenus">
        <% if logged_in? %>
          <li>
            <%= link_to user_path(current_user) do %>
              <i class="fas fa-user"></i> <%= current_user.name %>
            <% end %>
          </li>
          <li>
            <%= link_to about_path do %>
              <i class="fas fa-info-circle"></i> <%= t('nav.about') %>
            <% end %>
          </li>
          <li>
            <%= link_to user_messages_path do %>
              <i class="fas fa-comments"></i> <%= t('nav.posts') %>
            <% end %>
          </li>
          <li>
            <%= link_to new_user_message_path do %>
              <i class="fas fa-plus-circle"></i> <%= t('nav.new_post') %>
            <% end %>
          </li>
          <li>
            <%= link_to users_path do %>
              <i class="fas fa-users"></i> <%= t('nav.users') %>
            <% end %>
          </li>
          <li>
            <%= link_to logout_path, data: { turbo_method: :delete } do %>
              <i class="fas fa-sign-out-alt"></i> <%= t('nav.logout') %>
            <% end %>
          </li>
        <% else %>
          <li>
            <%= link_to about_path do %>
              <i class="fas fa-info-circle"></i> <%= t('nav.about') %>
            <% end %>
          </li>
          <li>
            <%= link_to new_user_path do %>
              <i class="fas fa-user-plus"></i> <%= t('nav.signup') %>
            <% end %>
          </li>
          <li>
            <%= link_to login_path do %>
              <i class="fas fa-sign-in-alt"></i> <%= t('nav.login') %>
            <% end %>
          </li>
        <% end %>
        <li class="language-switcher">
          <div class="lang-dropdown">
            <button class="lang-dropdown-btn" type="button">
              <i class="fas fa-globe"></i>
              <span><%= I18n.locale == :ja ? '日本語' : 'English' %></span>
              <i class="fas fa-chevron-down lang-arrow"></i>
            </button>
            <div class="lang-dropdown-menu">
              <%= link_to url_for(locale: :en), class: "lang-dropdown-item #{'active' if I18n.locale == :en}" do %>
                <span class="lang-flag">🇺🇸</span>
                <span class="lang-name">English</span>
                <% if I18n.locale == :en %>
                  <i class="fas fa-check lang-check"></i>
                <% end %>
              <% end %>
              <%= link_to url_for(locale: :ja), class: "lang-dropdown-item #{'active' if I18n.locale == :ja}" do %>
                <span class="lang-flag">🇯🇵</span>
                <span class="lang-name">日本語</span>
                <% if I18n.locale == :ja %>
                  <i class="fas fa-check lang-check"></i>
                <% end %>
              <% end %>
            </div>
          </div>
        </li>
      </ul>
    </header>

    <script>
      // Mobile menu toggle - using event delegation for Turbo compatibility
      document.addEventListener('click', function(event) {
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const headerMenus = document.getElementById('headerMenus');

        // Toggle mobile menu when clicking the button
        if (event.target.closest('#mobileMenuToggle')) {
          if (headerMenus) {
            headerMenus.classList.toggle('active');
            const icon = mobileMenuToggle.querySelector('i');
            if (headerMenus.classList.contains('active')) {
              icon.classList.remove('fa-bars');
              icon.classList.add('fa-times');
            } else {
              icon.classList.remove('fa-times');
              icon.classList.add('fa-bars');
            }
          }
          return;
        }

        // Close mobile menu when clicking outside header
        if (headerMenus && mobileMenuToggle && !event.target.closest('header')) {
          headerMenus.classList.remove('active');
          const icon = mobileMenuToggle.querySelector('i');
          if (icon) {
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
          }
        }

        // Close mobile menu when clicking a link inside it
        if (event.target.closest('.header-menus a')) {
          if (headerMenus && mobileMenuToggle) {
            headerMenus.classList.remove('active');
            const icon = mobileMenuToggle.querySelector('i');
            if (icon) {
              icon.classList.remove('fa-times');
              icon.classList.add('fa-bars');
            }
          }
        }
      });
    </script>
    <% flash.each do |key, value| %>
      <div class="flash <%= key %>">
        <% if key == "notice" %>
          <i class="fas fa-check-circle"></i>
        <% elsif key == "alert" %>
          <i class="fas fa-exclamation-triangle"></i>
        <% else %>
          <i class="fas fa-info-circle"></i>
        <% end %>
        <span><%= value %></span>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
