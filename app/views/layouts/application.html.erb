<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Post" %></title>
    <%= favicon_link_tag 'favicon.ico' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Post">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />


    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div class="header-logo">
        <%= link_to("Post","/") %>
      </div>

      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu">
        <i class="fas fa-bars"></i>
      </button>

      <ul class="header-menus" id="headerMenus">
        <% if logged_in? %>
          <li>
            <%= link_to user_path(current_user) do %>
              <i class="fas fa-user"></i> <%= current_user.name %>
            <% end %>
          </li>
          <li>
            <%= link_to "/about" do %>
              <i class="fas fa-info-circle"></i> About
            <% end %>
          </li>
          <li>
            <%= link_to user_messages_path do %>
              <i class="fas fa-comments"></i> Posts
            <% end %>
          </li>
          <li>
            <%= link_to new_user_message_path do %>
              <i class="fas fa-plus-circle"></i> New post
            <% end %>
          </li>
          <li>
            <%= link_to users_path do %>
              <i class="fas fa-users"></i> Users
            <% end %>
          </li>
          <li>
            <%= link_to logout_path, data: { turbo_method: :delete } do %>
              <i class="fas fa-sign-out-alt"></i> Log out
            <% end %>
          </li>
        <% else %>
          <li>
            <%= link_to "/about" do %>
              <i class="fas fa-info-circle"></i> About
            <% end %>
          </li>
          <li>
            <%= link_to new_user_path do %>
              <i class="fas fa-user-plus"></i> Sign up
            <% end %>
          </li>
          <li>
            <%= link_to login_path do %>
              <i class="fas fa-sign-in-alt"></i> Log in
            <% end %>
          </li>
        <% end %>
      </ul>
    </header>

    <script>
      // Mobile menu toggle
      document.addEventListener('DOMContentLoaded', function() {
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const headerMenus = document.getElementById('headerMenus');

        if (mobileMenuToggle && headerMenus) {
          mobileMenuToggle.addEventListener('click', function() {
            headerMenus.classList.toggle('active');
            const icon = this.querySelector('i');
            if (headerMenus.classList.contains('active')) {
              icon.classList.remove('fa-bars');
              icon.classList.add('fa-times');
            } else {
              icon.classList.remove('fa-times');
              icon.classList.add('fa-bars');
            }
          });

          // Close menu when clicking outside
          document.addEventListener('click', function(event) {
            if (!event.target.closest('header')) {
              headerMenus.classList.remove('active');
              const icon = mobileMenuToggle.querySelector('i');
              icon.classList.remove('fa-times');
              icon.classList.add('fa-bars');
            }
          });

          // Close menu when clicking a link
          headerMenus.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function() {
              headerMenus.classList.remove('active');
              const icon = mobileMenuToggle.querySelector('i');
              icon.classList.remove('fa-times');
              icon.classList.add('fa-bars');
            });
          });
        }
      });
    </script>
    <% flash.each do |key, value| %>
      <div class="flash <%= key %>">
        <% if key == "notice" %>
          <i class="fas fa-check-circle"></i>
        <% elsif key == "alert" %>
          <i class="fas fa-exclamation-triangle"></i>
        <% else %>
          <i class="fas fa-info-circle"></i>
        <% end %>
        <span><%= value %></span>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
