<%= stylesheet_link_tag("home") %>

<div class="main top-main">
    <div class="hero-content">
        <div class="hero-badge">
            <i class="fas fa-bolt"></i>
            <span><%= t('home.hero_badge') %></span>
        </div>

        <h1 class="hero-title">
            <%= t('home.hero_title') %><br>
            <span class="hero-highlight"><%= t('home.hero_highlight') %></span>
        </h1>

        <p class="hero-description">
            <%= t('home.hero_description') %>
        </p>

        <div class="hero-cta">
            <% if logged_in? %>
                <%= link_to new_user_message_path, class: "btn btn-hero btn-primary" do %>
                    <i class="fas fa-pencil-alt"></i> <%= t('home.create_post') %>
                <% end %>
                <%= link_to user_messages_path, class: "btn btn-hero btn-secondary-hero" do %>
                    <i class="fas fa-comments"></i> <%= t('home.browse_posts') %>
                <% end %>
            <% else %>
                <%= link_to new_user_path, class: "btn btn-hero btn-primary" do %>
                    <i class="fas fa-rocket"></i> <%= t('home.get_started') %>
                <% end %>
                <%= link_to login_path, class: "btn btn-hero btn-secondary-hero" do %>
                    <i class="fas fa-sign-in-alt"></i> <%= t('home.sign_in') %>
                <% end %>
            <% end %>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <i class="fas fa-users"></i>
                <div class="stat-content">
                    <span class="stat-number"><%= User.count %></span>
                    <span class="stat-label"><%= t('home.active_members') %></span>
                </div>
            </div>
            <div class="stat-item">
                <i class="fas fa-comments"></i>
                <div class="stat-content">
                    <span class="stat-number"><%= UserMessage.count %></span>
                    <span class="stat-label"><%= t('home.posts_shared') %></span>
                </div>
            </div>
            <div class="stat-item">
                <i class="fas fa-heart"></i>
                <div class="stat-content">
                    <span class="stat-number"><%= Like.count %></span>
                    <span class="stat-label"><%= t('home.reactions') %></span>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-features">
        <div class="feature-card">
            <div class="feature-icon">
                <i class="fas fa-bolt"></i>
            </div>
            <h3><%= t('home.lightning_fast') %></h3>
            <p><%= t('home.lightning_fast_desc') %></p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h3><%= t('home.safe_secure') %></h3>
            <p><%= t('home.safe_secure_desc') %></p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">
                <i class="fas fa-globe"></i>
            </div>
            <h3><%= t('home.global_community') %></h3>
            <p><%= t('home.global_community_desc') %></p>
        </div>
    </div>

    <!-- Cartoon-Style Decorative Elements -->
    <div class="hero-decoration">
        <div class="decoration-circle decoration-1"></div>
        <div class="decoration-circle decoration-2"></div>
        <div class="decoration-circle decoration-3"></div>

        <!-- Floating Emojis -->
        <div class="floating-emoji emoji-1">💭</div>
        <div class="floating-emoji emoji-2">❤️</div>
        <div class="floating-emoji emoji-3">🎨</div>
        <div class="floating-emoji emoji-4">🚀</div>
        <div class="floating-emoji emoji-5">⭐</div>
        <div class="floating-emoji emoji-6">🌈</div>
        <div class="floating-emoji emoji-7">💡</div>
        <div class="floating-emoji emoji-8">🎯</div>
    </div>
</div>
