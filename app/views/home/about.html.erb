<%= stylesheet_link_tag("home") %>

<div class="about-main">
  <div class="about-container">
    <div class="about-header">
      <h1><%= t('about.title') %></h1>
      <p class="about-tagline"><%= t('about.tagline') %></p>
    </div>

    <div class="about-section">
      <div class="about-icon">
        <i class="fas fa-heart"></i>
      </div>
      <h2><%= t('about.our_story') %></h2>
      <p><%= t('about.our_story_text') %></p>
    </div>

    <div class="about-section">
      <div class="about-icon">
        <i class="fas fa-lightbulb"></i>
      </div>
      <h2><%= t('about.our_mission') %></h2>
      <p><%= t('about.our_mission_text') %></p>
    </div>

    <div class="about-features">
      <h2><%= t('about.why_choose') %></h2>

      <div class="feature-grid">
        <div class="feature-item">
          <div class="feature-icon-small">
            <i class="fas fa-bolt"></i>
          </div>
          <h3><%= t('about.simple_fast') %></h3>
          <p><%= t('about.simple_fast_desc') %></p>
        </div>

        <div class="feature-item">
          <div class="feature-icon-small">
            <i class="fas fa-users"></i>
          </div>
          <h3><%= t('about.real_community') %></h3>
          <p><%= t('about.real_community_desc') %></p>
        </div>

        <div class="feature-item">
          <div class="feature-icon-small">
            <i class="fas fa-shield-alt"></i>
          </div>
          <h3><%= t('about.privacy_matters') %></h3>
          <p><%= t('about.privacy_matters_desc') %></p>
        </div>

        <div class="feature-item">
          <div class="feature-icon-small">
            <i class="fas fa-heart"></i>
          </div>
          <h3><%= t('about.support_appreciation') %></h3>
          <p><%= t('about.support_appreciation_desc') %></p>
        </div>

        <div class="feature-item">
          <div class="feature-icon-small">
            <i class="fas fa-globe"></i>
          </div>
          <h3><%= t('about.global_reach') %></h3>
          <p><%= t('about.global_reach_desc') %></p>
        </div>

        <div class="feature-item">
          <div class="feature-icon-small">
            <i class="fas fa-mobile-alt"></i>
          </div>
          <h3><%= t('about.always_accessible') %></h3>
          <p><%= t('about.always_accessible_desc') %></p>
        </div>
      </div>
    </div>

    <div class="about-section">
      <div class="about-icon">
        <i class="fas fa-compass"></i>
      </div>
      <h2><%= t('about.our_values') %></h2>
      <ul class="values-list">
        <li><strong><%= t('about.value_authenticity') %></strong> <%= t('about.value_authenticity_desc') %></li>
        <li><strong><%= t('about.value_respect') %></strong> <%= t('about.value_respect_desc') %></li>
        <li><strong><%= t('about.value_simplicity') %></strong> <%= t('about.value_simplicity_desc') %></li>
        <li><strong><%= t('about.value_community') %></strong> <%= t('about.value_community_desc') %></li>
        <li><strong><%= t('about.value_growth') %></strong> <%= t('about.value_growth_desc') %></li>
      </ul>
    </div>

    <div class="about-stats">
      <h2><%= t('about.growing_community') %></h2>
      <div class="stats-grid">
        <div class="stat-card">
          <i class="fas fa-users"></i>
          <div class="stat-number"><%= User.count %></div>
          <div class="stat-label"><%= t('home.active_members') %></div>
        </div>
        <div class="stat-card">
          <i class="fas fa-comments"></i>
          <div class="stat-number"><%= UserMessage.count %></div>
          <div class="stat-label"><%= t('home.posts_shared') %></div>
        </div>
        <div class="stat-card">
          <i class="fas fa-heart"></i>
          <div class="stat-number"><%= Like.count %></div>
          <div class="stat-label"><%= t('about.reactions_given') %></div>
        </div>
      </div>
    </div>

    <div class="about-cta">
      <h2><%= t('about.ready_to_share') %></h2>
      <p><%= t('about.join_community') %></p>
      <div class="cta-buttons">
        <% if logged_in? %>
          <%= link_to new_user_message_path, class: "btn btn-hero btn-primary" do %>
            <i class="fas fa-pencil-alt"></i> <%= t('about.create_first_post') %>
          <% end %>
        <% else %>
          <%= link_to new_user_path, class: "btn btn-hero btn-primary" do %>
            <i class="fas fa-rocket"></i> <%= t('about.join_today') %>
          <% end %>
          <%= link_to login_path, class: "btn btn-hero btn-secondary-hero" do %>
            <i class="fas fa-sign-in-alt"></i> <%= t('home.sign_in') %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="about-footer">
      <div class="credits">
        <h3><%= t('about.credits') %></h3>
        <p>
          <i class="fas fa-icons"></i>
          <a href="https://www.flaticon.com/free-icons/animals" title="animals icons" target="_blank" rel="noopener noreferrer">
            <%= t('about.avatar_credits') %>
          </a>
        </p>
        <p>
          <i class="fas fa-palette"></i>
          <%= t('about.color_credits') %> - <a href="https://nipponcolors.com/" target="_blank" rel="noopener noreferrer">NIPPON COLORS</a>
        </p>
        <p>
          <i class="fas fa-images"></i>
          <%= t('about.image_credits') %> - <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a>
        </p>
      </div>

      <div class="contact-info">
        <p><%= t('about.feedback') %></p>
        <p class="made-with-love">
          <i class="fas fa-heart"></i> <%= t('about.built_with_love') %>
        </p>
      </div>
    </div>
  </div>
</div>
