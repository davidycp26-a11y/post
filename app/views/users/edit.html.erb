<div class="main users-edit">
  <div class="container">
    <div class="form-heading"><%= t('users.edit_account') %></div>
    <%= form_with(model: @user, local: true, data: { turbo: false }) do |f| %>
      <div class="form users-form">
        <div class="form-body">
            <% @user.errors.full_messages.each do |msg| %>
              <div class="form-error">
                <%= msg %>
              </div>
            <% end %>

          <%= f.label :name, t('auth.name') %>
          <%= f.text_field :name, class: "form-control" %>

          <%= f.label :email, t('auth.email') %>
          <%= f.email_field :email, class: "form-control" %>

          <hr>

          <h3><%= t('users.choose_avatar') %></h3>

          <div data-controller="avatar-preview" class="avatar-select-area">

          <!-- Preview -->
          <div class="preview-box">
            <p><%= t('users.preview') %></p>
            <img
              src="<%= @user.avatar_url %>"
              data-avatar-preview-target="preview"
              class="avatar-preview-image"
            >
          </div>

          <!-- Avatar Selection -->
          <div class="avatar-list">
            <% User.avatar_options.each do |filename| %>
              <label class="avatar-option">
                <%= f.radio_button :image_name, filename,
                      checked: @user.image_name == filename,
                      data: { action: "avatar-preview#change" } %>

                <%= image_tag("/avatars/#{filename}", class: "avatar-thumb") %>
              </label>
            <% end %>
          </div>

        </div>
          <%= f.submit t('users.submit'), class: "btn btn-primary" %>
          <%= link_to user_path(@user), class: "btn btn-back" do %>
            <i class="fas fa-arrow-left"></i> <%= t('common.back') %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
