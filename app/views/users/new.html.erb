<div class="main users-new">
  <div class="container">
    <div class="form-heading"><%= t('auth.signup') %></div>
    <%= form_with(model: @user, local: true, data: { turbo: false }) do |f| %>
    <div class="form users-form">
      <div class="form-body">
          <% @user.errors.full_messages.each do |msg| %>
            <div class="form-error">
              <%= msg %>
            </div>
          <% end %>

        <%= f.label :name, t('auth.name') %>
        <%= f.text_field :name, class: "form-control" %>

        <%= f.label :email, t('auth.email') %>
        <%= f.email_field :email, class: "form-control" %>

        <%= f.label :password, t('auth.password') %>
        <%= f.password_field :password, class: "form-control" %>

        <%= f.submit t('auth.signup'), class: "btn btn-primary" %>
        <%= link_to t('auth.back'), root_path, class: "btn btn-secondary" %>
      </div>
    </div>
    <% end %>
  </div>
</div>
