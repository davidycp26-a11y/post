<div class="main users-index">
  <div class="container">
    <h1 class="users-heading">All Users</h1>
    <% @users.each do |user|%>
      <div class="users-index-item">
        <div class="user-left">
          <%= image_tag(user.avatar_url, class: "user-image") %>
        </div>
        <div class="user-right">
          <%= link_to user.name, user_path(user) %>
        </div>
      </div>
    <% end %>
  </div>
</div>