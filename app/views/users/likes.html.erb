<div class="main user-show">
  <div class="container">
    <div class="user">
      <%= image_tag(@user.avatar_url, class: "user-image") %>
      <h2><%= @user.name %></h2>
      <% if @current_user && @user.id == @current_user.id %>
        <p><%= @user.email %></p>
        <%= link_to("Edit", edit_user_path(@user)) %>
      <% end %>
    </div>

    <ul class="user-tabs">
      <li><%= link_to("Posts", user_path(@user.id)) %></li>
      <li class="active"><%= link_to("Likes", "/users/#{@user.id}/likes") %></li>
    </ul>
    
    <% @likes.each do |like| %>
      <% user_message = UserMessage.find_by(id: like.user_message_id)%>
      
      <div class="posts-index-item">
        <div class="post-left">
          <%= image_tag(user_message.user.avatar_url, class: "user-image") %>
        </div>
        <div class="post-right">
          <div class="post-user-name">
            <%= link_to(user_message.user.name, user_path(user_message.user)) %> 
          </div>
          <%= link_to(user_message.content, user_message_path(user_message)) %>
        </div>
      </div>
    <% end %>
  </div>
</div>