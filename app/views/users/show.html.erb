<div class="main user-show">
  <div class="container">
    <div class="user">
      <h2><%= @user.name %></h2>
      <p><%= @user.email %></p>
      <% if @user.id == @current_user.id %>
        <%= link_to("Edit", edit_user_path(@user)) %>
      <% end %>
    </div>
    <% @user.user_messages.each do |msg| %>
      <div class="posts-index-item">
        <div class="post-left">
        </div>
        <div class="post-right">
            <div class="post-user-name">
              <%= link_to(msg.user.name, user_path(msg.user)) %>
            </div>
          <%= link_to msg.content, user_message_path(msg) %>
        </div>
      </div>
    <% end %>
  </div>
</div>