<div class="main user-show">
  <div class="container">
    <div class="user">
      <%= image_tag(@user.avatar_url, class: "user-image") %>
      <h2><%= @user.name %></h2>
      <% if @current_user && @user.id == @current_user.id %>
        <p><%= @user.email %></p>
        <%= link_to edit_user_path(@user), class: "btn btn-edit" do %>
          <i class="fas fa-edit"></i> <%= t('users.edit') %>
        <% end %>
      <% end %>
    </div>

    <ul class="user-tabs">
      <li class="active"><%= link_to(t('users.posts_tab'), user_path(@user.id)) %></li>
      <li><%= link_to(t('users.likes_tab'), user_likes_path) %></li>
    </ul>

    <% @user.user_messages.each do |msg| %>
      <div class="posts-index-item">
        <div class="post-left">
          <%= image_tag(@user.avatar_url, class: "user-image") %>
        </div>
        <div class="post-right">
            <div class="post-user-name">
              <%= link_to(msg.user.name, user_path(msg.user)) %>
            </div>
          <%= link_to msg.content, user_message_path(msg) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
