<div class="main posts-new">
  <div class="container">
    <div class="page-header">
      <h1 class="form-heading"><%= t('posts.edit_post') %></h1>
      <%= link_to user_message_path(@user_message), class: "btn btn-back btn-back-top" do %>
        <i class="fas fa-arrow-left"></i> <%= t('common.back') %>
      <% end %>
    </div>

  <%= form_with(model: @user_message, data: { turbo: false }) do |f| %>
    <div class="form">
      <div class="form-body">
          <% @user_message.errors.full_messages.each do |msg| %>
            <div class="form-error">
              <%= msg %>
            </div>
          <% end %>
        <%= f.label :content, t('posts.message') %>
        <%= f.text_area :content, rows: 5, class: "form-control" %>
        <div class="form-actions">
          <%= link_to user_message_path(@user_message), class: "btn btn-back" do %>
            <i class="fas fa-arrow-left"></i> <%= t('common.back') %>
          <% end %>
          <%= f.submit t('posts.save'), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>

  </div>
</div>
