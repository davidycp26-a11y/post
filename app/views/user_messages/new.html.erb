<div class="main posts-new">
  <div class="container">
    <h1 class="form-heading">Create a new post</h1>
    <%= form_tag(new_user_message_path) do %>
      <div class="form">
        <div class="form-body">
          <textarea name="content"></textarea>
          <input type="submit" value="Post">
        </div>
      </div>
    <% end %>
  </div>
</div>