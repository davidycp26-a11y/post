<div class="main posts-new">
  <div class="container">
    <div class="page-header">
      <h1 class="form-heading">Create a new post</h1>
    </div>
    <%= form_with(model: @user_message, local: true, data: { turbo: false }) do |f| %>
      <div class="form">
        <div class="form-body">
          <% @user_message.errors.full_messages.each do |msg| %>
            <div class="form-error">
              <%= msg %>
            </div>
          <% end %>
          <%= f.label :content, "Message" %>
          <%= f.text_area :content, rows: 5, class: "form-control" %>
          <div class="form-actions">
            <%= link_to user_messages_path, class: "btn btn-back" do %>
              <i class="fas fa-arrow-left"></i> Back
            <% end %>
            <%= f.submit "Post", class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>