<div class="main posts-show">
  <div class="container">
    <div class="posts-show-item">
      <div class="post-user-name">
        <%= link_to @user.name, @user %>
      </div>
      <p>
        <%= @user_message.content %>
      </p>
      <div class="post-time">
        <%= @user_message.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
      </div>

      <% like = Like.find_by(user_id: current_user.id, user_message_id: @user_message.id) %>
      <% if like %>
        <%= button_to like_path(like), method: :delete, class: "like-button liked", form: { data: { turbo: true } } do %>
          <i class="fa fa-heart"></i>
        <% end %>
      <% else %>
        <%= button_to likes_path(user_message_id: @user_message.id), method: :post, class: "like-button not-liked", form: { data: { turbo: true } } do %>
          <i class="fa fa-heart"></i>
        <% end %>
      <% end %>


      <% if @user_message.user_id == @current_user.id %>
        <div class="post-menus">
          <%= button_to "Edit", edit_user_message_path(@user_message),
          method: :get %>
          <%= button_to "Delete", user_message_path(@user_message), 
            method: :delete, 
            data: { confirm: "Are you sure?" } %>
        </div>
      <% end %>

      <br>

      <div>
        <%= link_to "Back", user_messages_path, class: "btn" %>
      </div>
    </div>
  </div>
</div>