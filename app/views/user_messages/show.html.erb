<% # Conditionally wrap in turbo_frame_tag only if it's a turbo frame request %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag "post_detail" do %>
    <%= render partial: "user_messages/show_content", locals: { user_message: @user_message, user: @user, likes_count: @likes_count, comments: @comments, comment: @comment } %>
  <% end %>
<% else %>
  <div class="main posts-show">
    <div class="container">
      <%= render partial: "user_messages/show_content", locals: { user_message: @user_message, user: @user, likes_count: @likes_count, comments: @comments, comment: @comment } %>
    </div>
  </div>
<% end %>