<div class="main posts-show">
  <div class="container">
    <div class="posts-show-item">
      <p>
        <%= @user_message.content %>
      </p>
      <div class="post-time">
        <%= @user_message.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
      </div>
      <div class="post-menus">
        <%= button_to "Edit", edit_user_message_path(@user_message),
        method: :get %>
        <%= button_to "Delete", user_message_path(@user_message), 
          method: :delete, 
          data: { confirm: "Are you sure?" } %>
      </div>

      <br>

      <div>
        <%= link_to "Back", user_messages_path, class: "btn" %>
      </div>
    </div>
  </div>
</div>