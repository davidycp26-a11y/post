<div class="main posts-show">
  <div class="container">
    <div class="posts-show-item">
      <p>
        <%= @post.content %>
      </p>
      <div class="post-time">
        <%= @post.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
      </div>
      <%= link_to("Back", "/posts/index", class: "btn") %>
    </div>
  </div>
</div>