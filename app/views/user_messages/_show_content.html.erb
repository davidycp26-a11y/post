<div class="posts-show-item" data-controller="user-message-edit">
  <div class="post-layout">
      <div class="post-left">
        <%= image_tag(user.avatar_url) %>
      </div>

      <div class="post-right">
        <div class="post-user-name">
          <%= link_to user.name, user %>
        </div>

        <!-- Display Mode -->
        <div class="post-content" data-user-message-edit-target="display">
          <p><%= user_message.content %></p>
        </div>

        <!-- Edit Mode -->
        <div class="post-edit-form" data-user-message-edit-target="form" style="display: none;">
          <%= form_with(model: user_message, class: "inline-post-form", data: { turbo_frame: "_top" }) do |f| %>
            <%= f.text_area :content,
                rows: 5,
                class: "form-control",
                maxlength: 300,
                data: { user_message_edit_target: "textarea" } %>
            <div class="comment-edit-actions">
              <%= f.submit t('posts.save'), class: "btn btn-primary btn-sm" %>
              <button type="button" class="btn btn-back btn-sm" data-action="click->user-message-edit#cancel">
                <%= t('posts.cancel') %>
              </button>
            </div>
          <% end %>
        </div>

        <div class="post-time">
          <%= user_message.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
        </div>

        <div class="post-footer">
          <div class="like-container">
            <% like = Like.find_by(user_id: current_user.id, user_message_id: user_message.id) %>
            <% if like %>
              <%= button_to like_path(like), method: :delete, class: "like-button liked", form: { data: { turbo: true } } do %>
                <i class="fa fa-heart"></i>
              <% end %>
            <% else %>
              <%= button_to likes_path(user_message_id: user_message.id), method: :post, class: "like-button not-liked", form: { data: { turbo: true } } do %>
                <i class="fa fa-heart"></i>
              <% end %>
            <% end %>
            <span class="likes-count"><%= likes_count %></span>
          </div>

          <% if user_message.user_id == current_user.id %>
            <div class="post-menus" data-user-message-edit-target="actions">
              <button type="button" class="btn btn-edit btn-sm" data-action="click->user-message-edit#edit">
                <i class="fas fa-edit"></i> <%= t('common.edit') %>
              </button>
              <%= button_to user_message_path(user_message),
                method: :delete,
                class: "btn btn-delete btn-sm",
                data: { confirm: t('posts.confirm_delete'), turbo: true } do %>
                <i class="fas fa-trash"></i> <%= t('common.delete') %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Comments Section -->
    <div class="comments-section">
      <h3 class="comments-heading">
        <i class="fas fa-comments"></i>
        <%= t('comments.title') %> (<%= comments.count %>)
      </h3>

      <div class="comments-list">
        <% if comments.any? %>
          <%= render comments %>
        <% else %>
          <p class="no-comments"><%= t('comments.no_comments') %></p>
        <% end %>
      </div>

      <!-- Comment Form -->
      <% if logged_in? %>
        <div class="comment-form-container">
          <h4><%= t('comments.add_comment') %></h4>
          <%= form_with(model: comment, class: "comment-form") do |f| %>
            <div class="comment-form-input">
              <%= f.text_area :content,
                  rows: 3,
                  placeholder: t('comments.write_placeholder'),
                  class: "form-control",
                  maxlength: 200,
                  id: "comment-textarea" %>
              <%= f.hidden_field :user_message_id, value: user_message.id %>

              <div class="comment-form-actions">
                <%= f.submit t('comments.post_comment'), class: "btn btn-primary btn-sm" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="login-prompt">
          <%= link_to t('comments.login_to_comment'), login_path %>
        </p>
      <% end %>
    </div>
  </div>
</div>
