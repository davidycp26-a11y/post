<div class="main posts-index">
  <div class="container">
    <% @user_messages.each do |msg| %>
      <div class="posts-index-item">
        <div class="post-left">
        <%= image_tag(msg.user.avatar_url, class: "user-image") %>
        </div>
        <div class="post-right">
            <div class="post-user-name">
              <%= link_to(msg.user.name, user_path(msg.user)) %>
            </div>
          <%= link_to msg.content, user_message_path(msg) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
