<div class="main users-new">
  <div class="container">
    <div class="form-heading">Log in</div>
    <%= form_with(url: login_path, local: true, scope: :session, data: { turbo: false }) do |f| %>
      <div class="form users-form">
        <div class="form-body">
          <p>Email</p>
            <%= f.email_field :email, value: params.dig(:session, :email), class: "form-control" %>
          <p>Password</p>
            <%= f.password_field :password, class: "form-control" %>
          <%= f.submit "Log in", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>